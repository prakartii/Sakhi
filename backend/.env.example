# Copy to backend/.env and fill in real values. Never commit the real .env
# (the repo's root .gitignore already excludes .env / .env.* at every depth).

# --- App ---
APP_NAME=Sakhi API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- CORS: comma-separated origins allowed to call this API ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Database (Supabase Postgres connection string) ---
# Same value as the root .env's DATABASE_URL. Standard postgresql:// form —
# app/core/config.py rewrites the scheme to postgresql+psycopg:// at load time.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Supabase (service-level access, e.g. Storage — not used yet) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth secret (stored for later — authentication is not implemented yet) ---
JWT_SECRET=

# --- AI provider (app.ai.providers) ---
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024

# --- Embedding provider (app.ai.embeddings) ---
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Image provider (app.ai.image) ---
IMAGE_PROVIDER=together
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free

# --- Voice provider (app.ai.voice) ---
VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_TIMEOUT_SECONDS=15.0
VOICE_TRANSLATE_PIVOT=false
